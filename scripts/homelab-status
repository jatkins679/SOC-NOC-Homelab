#!/usr/bin/env bash

set -u

REPO="$HOME/SOC-NOC-Homelab"
LOGDIR="${XDG_STATE_HOME:-$HOME/.local/state}/homelab"

if [ ! -d "$REPO" ]; then
    echo "ERROR: Repository not found at $REPO"
    exit 1
fi

mkdir -p "$LOGDIR"

timestamp="$(date '+%Y%m%d-%H%M%S')"
logfile="$LOGDIR/homelab-status-$timestamp.log"

ln -sfn "$(basename "$logfile")" "$LOGDIR/latest.log"

exec > >(tee "$logfile") 2>&1

echo
echo "============================================================"
echo " HOMELAB MANAGEMENT STATUS"
echo " $(date)"
echo "============================================================"
echo

echo "=== Network and Service Reachability ==="
"$REPO/scripts/homelab-health"
network_rc=$?

echo
echo "=== Proxmox Cluster Health ==="
"$REPO/scripts/proxmox-health" --brief
proxmox_rc=$?

echo
echo "=== Linux Infrastructure Health ==="
"$REPO/scripts/linux-health" --brief
linux_rc=$?

echo
echo "=== Storage Infrastructure Health ==="
"$REPO/scripts/storage-health"
storage_rc=$?

echo
echo "============================================================"

if [ "$network_rc" -eq 0 ] &&
   [ "$proxmox_rc" -eq 0 ] &&
   [ "$linux_rc" -eq 0 ] &&
   [ "$storage_rc" -eq 0 ]; then

    echo "OVERALL STATUS: HEALTHY"
    rc=0
else
    echo "OVERALL STATUS: ATTENTION REQUIRED"
    echo "Network/service check: $network_rc"
    echo "Proxmox check:        $proxmox_rc"
    echo "Linux check:          $linux_rc"
    echo "Storage check:        $storage_rc"
    rc=1
fi

echo "Log: $logfile"
echo "============================================================"
echo

exit "$rc"
